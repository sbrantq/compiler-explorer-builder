# Default settings for C++
compilers=&clang-enzyme-main:&reclang-enzyme-main:&clang-enzyme-poseidon
tools=clangquerydefault:strings:ldd:poseidon-report:poseidon-source:poseidon-diff:poseidon-fpcore

tools.clangquerydefault.exe=/usr/bin/clang-query
tools.clangquerydefault.name=clang-query (default)
tools.clangquerydefault.type=independent
tools.clangquerydefault.class=clang-query-tool
tools.clangquerydefault.stdinHint=Query commands

tools.ldd.name=ldd
tools.ldd.exe=/usr/bin/lld-${{ compilers[0].version }}
tools.ldd.type=postcompilation
tools.ldd.class=readelf-tool
tools.ldd.exclude=djggp
tools.ldd.stdinHint=disabled

tools.strings.exe=/usr/bin/strings
tools.strings.name=strings
tools.strings.type=postcompilation
tools.strings.class=strings-tool
tools.strings.exclude=djggp
tools.strings.stdinHint=disabled

tools.poseidon-report.name=Poseidon report
tools.poseidon-report.exe=/opt/compiler-explorer/poseidon/poseidon-explain-ce.sh
tools.poseidon-report.type=postcompilation
tools.poseidon-report.class=testing-tool
tools.poseidon-report.options=report
tools.poseidon-report.includeKey=supportsPoseidon
tools.poseidon-report.stdinHint=disabled

tools.poseidon-source.name=Poseidon source
tools.poseidon-source.exe=/opt/compiler-explorer/poseidon/poseidon-explain-ce.sh
tools.poseidon-source.type=postcompilation
tools.poseidon-source.class=miri-tool
tools.poseidon-source.options=source
tools.poseidon-source.includeKey=supportsPoseidon
tools.poseidon-source.stdinHint=disabled
tools.poseidon-source.languageId=cppp

tools.poseidon-diff.name=Poseidon diff
tools.poseidon-diff.exe=/opt/compiler-explorer/poseidon/poseidon-explain-ce.sh
tools.poseidon-diff.type=postcompilation
tools.poseidon-diff.class=miri-tool
tools.poseidon-diff.options=diff
tools.poseidon-diff.includeKey=supportsPoseidon
tools.poseidon-diff.stdinHint=disabled

tools.poseidon-fpcore.name=Poseidon FPCore
tools.poseidon-fpcore.exe=/opt/compiler-explorer/poseidon/poseidon-explain-ce.sh
tools.poseidon-fpcore.type=postcompilation
tools.poseidon-fpcore.class=miri-tool
tools.poseidon-fpcore.options=fpcore
tools.poseidon-fpcore.includeKey=supportsPoseidon
tools.poseidon-fpcore.stdinHint=disabled

defaultCompiler=clang${{ compilers[0].version }}-enzyme-main
postProcess=
demangler=c++filt
demanglerType=cpp
objdumper=objdump
options=
supportsBinary=true
binaryHideFuncRe=^(__.*|_(init|start|fini)|(de)?register_tm_clones|call_gmon_start|frame_dummy|\.plt.*|_dl_relocate_static_pie)$
needsMulti=false
stubRe=\bmain\b
stubText=int main(void){return 0;/*stub provided by Compiler Explorer*/}
supportsLibraryCodeFilter=true

{% include 'libs.j2' %}

group.clang-enzyme-main.compilers={% for compiler in compilers %}clang{{ compiler.version }}-enzyme-main{% if not loop.last %}:{% endif %}{% endfor %}
group.clang-enzyme-main.intelAsm=-mllvm --x86-asm-syntax=intel
group.clang-enzyme-main.compilerType=clang
group.clang-enzyme-main.supportsExecute=true
group.clang-enzyme-main.isSemVer=true
group.clang-enzyme-main.groupName=CLANG + ENZYME (main)
group.clang-enzyme-main.options=-fno-discard-value-names

{% for compiler in compilers %}
compiler.clang{{ compiler.version }}-enzyme-main.exe=/usr/bin/clang++-{{ compiler.version }}
compiler.clang{{ compiler.version }}-enzyme-main.options=-fplugin=/opt/compiler-explorer/main/ClangEnzyme-{{ compiler.version }}.so -I/opt/compiler-explorer/libraries/include -L/opt/compiler-explorer/lib
compiler.clang{{ compiler.version }}-enzyme-main.semver={{ compiler.semver }}
compiler.clang{{ compiler.version }}-enzyme-main.name=clang {{ compiler.version }} ({{ compiler.enzyme_commit }})
{% endfor %}

{% for compiler in compilers %}
compiler.cuclang{{ compiler.version }}-enzyme-main.semver={{ compiler.semver }}
{% endfor %}

group.reclang-enzyme-main.compilers=reclang
group.reclang-enzyme-main.intelAsm=-mllvm --x86-asm-syntax=intel
group.reclang-enzyme-main.compilerType=clang
group.reclang-enzyme-main.supportsExecute=true
group.reclang-enzyme-main.isSemVer=true
group.reclang-enzyme-main.groupName=REACTANT CLANG (main)
group.reclang-enzyme-main.options=-fno-discard-value-names

compiler.reclang.exe=/opt/compiler-explorer/main/reactant-clang
compiler.reclang.options=-resource-dir=/usr/lib/llvm-21/lib/clang/21 -I/opt/compiler-explorer/libraries/include -L/opt/compiler-explorer/lib
compiler.reclang.name=Reactant Clang ({{ reactant_commit }})

# Poseidon, from the poseidon branch of EnzymeAD/Enzyme, installed by
# update-versions.py. Its tools show only for compilers with supportsPoseidon=true.
group.clang-enzyme-poseidon.compilers=clang21-poseidon
group.clang-enzyme-poseidon.intelAsm=-mllvm --x86-asm-syntax=intel
group.clang-enzyme-poseidon.compilerType=clang
group.clang-enzyme-poseidon.supportsExecute=true
group.clang-enzyme-poseidon.isSemVer=true
group.clang-enzyme-poseidon.groupName=CLANG + POSEIDON (poseidon)
group.clang-enzyme-poseidon.supportsPoseidon=true

compiler.clang21-poseidon.exe=/opt/compiler-explorer/poseidon/clang++
compiler.clang21-poseidon.options=-O2 -fno-discard-value-names -Rpass=poseidon -Rpass-analysis=poseidon -I/opt/compiler-explorer/libraries/include -L/opt/compiler-explorer/lib
compiler.clang21-poseidon.semver=21
compiler.clang21-poseidon.name=clang 21 + Poseidon ({{ poseidon_commit }})
